# ---------------------------------------------------------------------------
# Fichiers volontairement exclus du dépôt Git (qui est PUBLIC)
# ---------------------------------------------------------------------------

# Configuration locale : chemins, réglages, jamais versionnée.
/config.local.php
*.local.php
.env
.env.*

# Base de données, sauvegardes et fichiers envoyés.
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db
*.bak
*.dump

# Stockage local (développement) : aucun document réel dans Git.
/storage/*
!/storage/.gitkeep
!/storage/README.md

# Journaux et fichiers temporaires.
*.log
/var/
/tmp/
.cache/
.DS_Store
Thumbs.db
desktop.ini

# Outils de développement (non nécessaires en production).
node_modules/
vendor/
package-lock.json
.phpunit.result.cache

# Éditeurs
.idea/
.vscode/
*.swp
*~
